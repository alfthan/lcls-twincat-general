<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_ECATepics" Id="{38ed9c12-1d10-4e74-8cdb-42be0630d47c}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_ECATepics
VAR_INPUT
    sNetId          : T_AmsNetId;
    nSlaveAddr      : UINT;
    sDeviceDesc		: T_MaxString := 'TERM #';
END_VAR
VAR_OUTPUT
END_VAR
VAR

    {attribute 'pytmc' := '
        pv: bCmdReqState
    '}

    bCmdReqState : BOOL;

    {attribute 'pytmc' := '
        pv: eReqState
    '}
    eReqState : E_ECAT_STATES;
    ePrevReqState : E_ECAT_STATES;

    {attribute 'pytmc' := '
        pv: eDevState
        io: o
        field: ZRSV MAJOR
        field: ONSV MAJOR
        field: TWSV MAJOR
        field: THSV MAJOR
        field: FRSV NO_ALARM
        field: FVSV MAJOR
    '}
    eDevState : E_ECAT_STATES;

    {attribute 'pytmc' := '
        pv: bError
        io: o
    '}
    bDevError : BOOL;

    {attribute 'pytmc' := '
        pv: sErrorMessage
        io: o
    '}
    sErrorMessage : STRING;

    {attribute 'pytmc' := '
        pv: sDESC
        io: io
    '}
    sDevDesc : STRING;

    fbsetSlaveState         : FB_EcSetSlaveState;
    fbgetSlaveState			: FB_EcGetSlaveState;
    fbgetStatusTimer : TON;
    bInit : BOOL := TRUE;

END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[fbgetStatusTimer(PT:= T#500MS);

IF bInit THEN
    sDevDesc := sDeviceDesc;
    bInit := FALSE;
    fbgetStatusTimer.IN:= TRUE;
    ePrevReqState :=  eReqState;
END_IF

fbsetSlaveState(sNetId:=sNetId,
    nSlaveAddr:= nSlaveAddr,
    bExecute:= bCmdReqState,
    reqState:= eReqState);

fbgetSlaveState(sNetId:=sNetId,
    nSlaveAddr:= nSlaveAddr,
    bExecute:= fbgetStatusTimer.Q);

CASE fbgetSlaveState.state.deviceState OF
    EC_DEVICE_STATE_INIT:
        eDevState := E_ECAT_STATES.INIT;
    EC_DEVICE_STATE_PREOP:
        eDevState := E_ECAT_STATES.PREOP;
    EC_DEVICE_STATE_BOOTSTRAP:
        eDevState := E_ECAT_STATES.BOOTSTRAP;
    EC_DEVICE_STATE_SAFEOP:
        eDevState := E_ECAT_STATES.SAFEOP;
    EC_DEVICE_STATE_OP:
        eDevState := E_ECAT_STATES.OP;
    EC_DEVICE_STATE_ERROR:
        eDevState := E_ECAT_STATES.ERROR;
END_CASE

bDevError := fbsetSlaveState.bError;

IF bCmdReqState AND (bDevError OR (NOT fbsetSlaveState.bBusy)) THEN
    bCmdReqState := FALSE;
END_IF

CASE fbsetSlaveState.nErrId OF
    0: sErrorMessage := '';
    // --- Device errors (0x700 - 0x739), named in ADSConstants ---
    ADSConstants.ADSERR_DEVICE_ERROR: sErrorMessage := 'ADSERR_DEVICE_ERROR - General device error.';
    ADSConstants.ADSERR_DEVICE_SRVNOTSUPP: sErrorMessage := 'ADSERR_DEVICE_SRVNOTSUPP - Service is not supported by the server.';
    ADSConstants.ADSERR_DEVICE_INVALIDGRP: sErrorMessage := 'ADSERR_DEVICE_INVALIDGRP - Invalid index group.';
    ADSConstants.ADSERR_DEVICE_INVALIDOFFSET: sErrorMessage := 'ADSERR_DEVICE_INVALIDOFFSET - Invalid index offset.';
    ADSConstants.ADSERR_DEVICE_INVALIDACCESS: sErrorMessage := 'ADSERR_DEVICE_INVALIDACCESS - Reading or writing not permitted. ';
    ADSConstants.ADSERR_DEVICE_INVALIDSIZE: sErrorMessage := 'ADSERR_DEVICE_INVALIDSIZE - Parameter size not correct.';
    ADSConstants.ADSERR_DEVICE_INVALIDDATA: sErrorMessage := 'ADSERR_DEVICE_INVALIDDATA - Invalid data values.';
    ADSConstants.ADSERR_DEVICE_NOTREADY: sErrorMessage := 'ADSERR_DEVICE_NOTREADY - Device is not ready to operate.';
    ADSConstants.ADSERR_DEVICE_BUSY: sErrorMessage := 'ADSERR_DEVICE_BUSY - Device is busy.';
    ADSConstants.ADSERR_DEVICE_INVALIDCONTEXT: sErrorMessage := 'ADSERR_DEVICE_INVALIDCONTEXT - Invalid operating system context.';
    ADSConstants.ADSERR_DEVICE_NOMEMORY: sErrorMessage := 'ADSERR_DEVICE_NOMEMORY - Insufficient memory.';
    ADSConstants.ADSERR_DEVICE_INVALIDPARM: sErrorMessage := 'ADSERR_DEVICE_INVALIDPARM - Invalid parameter values.';
    ADSConstants.ADSERR_DEVICE_NOTFOUND: sErrorMessage := 'ADSERR_DEVICE_NOTFOUND - Not found (files, ...).';
    ADSConstants.ADSERR_DEVICE_SYNTAX: sErrorMessage := 'ADSERR_DEVICE_SYNTAX - Syntax error in file or command.';
    ADSConstants.ADSERR_DEVICE_INCOMPATIBLE: sErrorMessage := 'ADSERR_DEVICE_INCOMPATIBLE - Objects do not match.';
    ADSConstants.ADSERR_DEVICE_EXISTS: sErrorMessage := 'ADSERR_DEVICE_EXISTS - Object already exists.';
    ADSConstants.ADSERR_DEVICE_SYMBOLNOTFOUND: sErrorMessage := 'ADSERR_DEVICE_SYMBOLNOTFOUND - Symbol not found.';
    ADSConstants.ADSERR_DEVICE_SYMBOLVERSIONINVALID: sErrorMessage := 'ADSERR_DEVICE_SYMBOLVERSIONINVALID - Invalid symbol version. This can occur due to an online change. Create a new handle.';
    ADSConstants.ADSERR_DEVICE_INVALIDSTATE: sErrorMessage := 'ADSERR_DEVICE_INVALIDSTATE - Device (server) is in invalid state.';
    ADSConstants.ADSERR_DEVICE_TRANSMODENOTSUPP: sErrorMessage := 'ADSERR_DEVICE_TRANSMODENOTSUPP - AdsTransMode not supported.';
    ADSConstants.ADSERR_DEVICE_NOTIFYHNDINVALID: sErrorMessage := 'ADSERR_DEVICE_NOTIFYHNDINVALID - Notification handle is invalid.';
    ADSConstants.ADSERR_DEVICE_CLIENTUNKNOWN: sErrorMessage := 'ADSERR_DEVICE_CLIENTUNKNOWN - Notification client not registered.';
    ADSConstants.ADSERR_DEVICE_NOMOREHDLS: sErrorMessage := 'ADSERR_DEVICE_NOMOREHDLS - No further handle available.';
    ADSConstants.ADSERR_DEVICE_INVALIDWATCHSIZE: sErrorMessage := 'ADSERR_DEVICE_INVALIDWATCHSIZE - Notification size too large.';
    ADSConstants.ADSERR_DEVICE_NOTINIT: sErrorMessage := 'ADSERR_DEVICE_NOTINIT - Device not initialized.';
    ADSConstants.ADSERR_DEVICE_TIMEOUT: sErrorMessage := 'ADSERR_DEVICE_TIMEOUT - Device has a timeout.';
    ADSConstants.ADSERR_DEVICE_NOINTERFACE: sErrorMessage := 'ADSERR_DEVICE_NOINTERFACE - Interface query failed.';
    ADSConstants.ADSERR_DEVICE_INVALIDINTERFACE: sErrorMessage := 'ADSERR_DEVICE_INVALIDINTERFACE - Wrong interface requested.';
    ADSConstants.ADSERR_DEVICE_INVALIDCLSID: sErrorMessage := 'ADSERR_DEVICE_INVALIDCLSID - Class ID is invalid.';
    ADSConstants.ADSERR_DEVICE_INVALIDOBJID: sErrorMessage := 'ADSERR_DEVICE_INVALIDOBJID - Object ID is invalid.';
    ADSConstants.ADSERR_DEVICE_PENDING: sErrorMessage := 'ADSERR_DEVICE_PENDING - Request pending.';
    ADSConstants.ADSERR_DEVICE_ABORTED: sErrorMessage := 'ADSERR_DEVICE_ABORTED - Request is aborted.';
    ADSConstants.ADSERR_DEVICE_WARNING: sErrorMessage := 'ADSERR_DEVICE_WARNING - Signal warning.';
    ADSConstants.ADSERR_DEVICE_INVALIDARRAYIDX: sErrorMessage := 'ADSERR_DEVICE_INVALIDARRAYIDX - Invalid array index.';
    ADSConstants.ADSERR_DEVICE_SYMBOLNOTACTIVE: sErrorMessage := 'ADSERR_DEVICE_SYMBOLNOTACTIVE - Symbol not active.';
    ADSConstants.ADSERR_DEVICE_ACCESSDENIED: sErrorMessage := 'ADSERR_DEVICE_ACCESSDENIED - Access denied.';
    ADSConstants.ADSERR_DEVICE_LICENSENOTFOUND: sErrorMessage := 'ADSERR_DEVICE_LICENSENOTFOUND - Missing license.';
    ADSConstants.ADSERR_DEVICE_LICENSEEXPIRED: sErrorMessage := 'ADSERR_DEVICE_LICENSEEXPIRED - License expired.';
    ADSConstants.ADSERR_DEVICE_LICENSEEXCEEDED: sErrorMessage := 'ADSERR_DEVICE_LICENSEEXCEEDED - License exceeded.';
    ADSConstants.ADSERR_DEVICE_LICENSEINVALID: sErrorMessage := 'ADSERR_DEVICE_LICENSEINVALID - Invalid license.';
    ADSConstants.ADSERR_DEVICE_LICENSESYSTEMID: sErrorMessage := 'ADSERR_DEVICE_LICENSESYSTEMID - License problem: System ID is invalid.';
    ADSConstants.ADSERR_DEVICE_LICENSENOTIMELIMIT: sErrorMessage := 'ADSERR_DEVICE_LICENSENOTIMELIMIT - License not limited in time.';
    ADSConstants.ADSERR_DEVICE_LICENSEFUTUREISSUE: sErrorMessage := 'ADSERR_DEVICE_LICENSEFUTUREISSUE - Licensing problem: time in the future.';
    ADSConstants.ADSERR_DEVICE_LICENSETIMETOLONG: sErrorMessage := 'ADSERR_DEVICE_LICENSETIMETOLONG - License period too long.';
    ADSConstants.ADSERR_DEVICE_EXCEPTION: sErrorMessage := 'ADSERR_DEVICE_EXCEPTION - Exception at system startup.';
    ADSConstants.ADSERR_DEVICE_LICENSEDUPLICATED: sErrorMessage := 'ADSERR_DEVICE_LICENSEDUPLICATED - License file read twice.';
    ADSConstants.ADSERR_DEVICE_SIGNATUREINVALID: sErrorMessage := 'ADSERR_DEVICE_SIGNATUREINVALID - Invalid signature.';
    ADSConstants.ADSERR_DEVICE_CERTIFICATEINVALID: sErrorMessage := 'ADSERR_DEVICE_CERTIFICATEINVALID - Invalid certificate.';
    ADSConstants.ADSERR_DEVICE_LICENSEOEMNOTFOUND: sErrorMessage := 'ADSERR_DEVICE_LICENSEOEMNOTFOUND - Public key not known from OEM.';
    ADSConstants.ADSERR_DEVICE_LICENSERESTRICTED: sErrorMessage := 'ADSERR_DEVICE_LICENSERESTRICTED - License not valid for this system ID.';
    ADSConstants.ADSERR_DEVICE_LICENSEDEMODENIED: sErrorMessage := 'ADSERR_DEVICE_LICENSEDEMODENIED - Demo license prohibited.';
    ADSConstants.ADSERR_DEVICE_INVALIDFNCID: sErrorMessage := 'ADSERR_DEVICE_INVALIDFNCID - Invalid function ID.';
    ADSConstants.ADSERR_DEVICE_OUTOFRANGE: sErrorMessage := 'ADSERR_DEVICE_OUTOFRANGE - Outside the valid range.';
    ADSConstants.ADSERR_DEVICE_INVALIDALIGNMENT: sErrorMessage := 'ADSERR_DEVICE_INVALIDALIGNMENT - Invalid alignment.';
    ADSConstants.ADSERR_DEVICE_LICENSEPLATFORM: sErrorMessage := 'ADSERR_DEVICE_LICENSEPLATFORM - Invalid platform level.';
    ADSConstants.ADSERR_DEVICE_FORWARD_PL: sErrorMessage := 'ADSERR_DEVICE_FORWARD_PL - Context - forward to passive level.';
    ADSConstants.ADSERR_DEVICE_FORWARD_DL: sErrorMessage := 'ADSERR_DEVICE_FORWARD_DL - Context - forward to dispatch level.';
    ADSConstants.ADSERR_DEVICE_FORWARD_RT: sErrorMessage := 'ADSERR_DEVICE_FORWARD_RT - Context - forward to real-time.';

    ELSE
    sErrorMessage := 'Unknown ADS error code.';
END_CASE

IF fbgetStatusTimer.Q THEN
     fbgetStatusTimer.IN := FALSE; // reset timer
ELSE
    fbgetStatusTimer.IN := TRUE; // reset timer
END_IF]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>