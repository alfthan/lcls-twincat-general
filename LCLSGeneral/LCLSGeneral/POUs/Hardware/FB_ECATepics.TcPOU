<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_ECATepics" Id="{38ed9c12-1d10-4e74-8cdb-42be0630d47c}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_ECATepics
(*
    Exposes one EtherCAT slave's state to EPICS and lets EPICS request a state
    transition of that slave.

    The slave is addressed by the AMS Net ID of its master (sNetId) and its
    EtherCAT address (nSlaveAddr). The requested state and the state read back
    from the master are exchanged through the single VAR_IN_OUT interface struct
    ST_ECATepics_IO, which holds every command and status value that crosses into
    EPICS. The ADS addressing stays on the block, because it is static
    configuration rather than command/status data.

    The device state is polled every 500 ms. A state request drops again as soon
    as it has completed, and an ADS error raised by the request is mapped to a
    human readable message.

    Usage:
        stEcatIO : ST_ECATepics_IO;
        fbEcat : FB_ECATepics;
        fbEcat(stEcatIO := stEcatIO, sNetId := '1.2.3.4.5.1', nSlaveAddr := 1001);

    2026-11-27 Replaced the individual command/status variables with the ST_ECATepics_IO VAR_IN_OUT
*)
VAR_IN_OUT
    // Command and status interface of the supervised EtherCAT slave
    stEcatIO : ST_ECATepics_IO;
END_VAR
VAR_INPUT
    // AMS Net ID of the EtherCAT master that owns the slave
    sNetId : T_AmsNetId;
    // EtherCAT address (slave position) of the supervised terminal
    nSlaveAddr : UINT;
    // Device description copied into stEcatIO.sDevDesc on the first scan
    sDeviceDesc : T_MaxString := 'TERM #';
END_VAR
VAR
    // Slave state request handed to the EtherCAT master
    fbsetSlaveState : FB_EcSetSlaveState;
    // Slave state read back from the EtherCAT master
    fbgetSlaveState : FB_EcGetSlaveState;
    // Poll interval for the slave state read back
    fbgetStatusTimer : TON;
    // TRUE until the block has run its first scan initialisation
    bInit : BOOL := TRUE;
    // Last requested state, kept for change detection
    ePrevReqState : E_ECAT_STATES;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[fbgetStatusTimer(PT:= T#500MS);

IF bInit THEN
    stEcatIO.sDevDesc := sDeviceDesc;
    bInit := FALSE;
    fbgetStatusTimer.IN:= TRUE;
    ePrevReqState := stEcatIO.eReqState;
END_IF

fbsetSlaveState(sNetId:=sNetId,
    nSlaveAddr:= nSlaveAddr,
    bExecute:= stEcatIO.bCmdReqState,
    reqState:= stEcatIO.eReqState);

fbgetSlaveState(sNetId:=sNetId,
    nSlaveAddr:= nSlaveAddr,
    bExecute:= fbgetStatusTimer.Q);

CASE fbgetSlaveState.state.deviceState OF
    EC_DEVICE_STATE_INIT:
        stEcatIO.eDevState := E_ECAT_STATES.INIT;
    EC_DEVICE_STATE_PREOP:
        stEcatIO.eDevState := E_ECAT_STATES.PREOP;
    EC_DEVICE_STATE_BOOTSTRAP:
        stEcatIO.eDevState := E_ECAT_STATES.BOOTSTRAP;
    EC_DEVICE_STATE_SAFEOP:
        stEcatIO.eDevState := E_ECAT_STATES.SAFEOP;
    EC_DEVICE_STATE_OP:
        stEcatIO.eDevState := E_ECAT_STATES.OP;
    EC_DEVICE_STATE_ERROR:
        stEcatIO.eDevState := E_ECAT_STATES.ERROR;
END_CASE

stEcatIO.bDevError := fbsetSlaveState.bError;

IF stEcatIO.bCmdReqState AND (stEcatIO.bDevError OR (NOT fbsetSlaveState.bBusy)) THEN
    stEcatIO.bCmdReqState := FALSE;
END_IF

CASE fbsetSlaveState.nErrId OF
    0: stEcatIO.sErrorMessage := '';
    // --- Device errors (0x700 - 0x739) ---
    1792: stEcatIO.sErrorMessage := 'ADSERR_DEVICE_ERROR - General device error.';
    1793: stEcatIO.sErrorMessage := 'ADSERR_DEVICE_SRVNOTSUPP - Service is not supported by the server.';
    1794: stEcatIO.sErrorMessage := 'ADSERR_DEVICE_INVALIDGRP - Invalid index group.';
    1795: stEcatIO.sErrorMessage := 'ADSERR_DEVICE_INVALIDOFFSET - Invalid index offset.';
    1796: stEcatIO.sErrorMessage := 'ADSERR_DEVICE_INVALIDACCESS - Reading or writing not permitted. ';
    1797: stEcatIO.sErrorMessage := 'ADSERR_DEVICE_INVALIDSIZE - Parameter size not correct.';
    1798: stEcatIO.sErrorMessage := 'ADSERR_DEVICE_INVALIDDATA - Invalid data values.';
    1799: stEcatIO.sErrorMessage := 'ADSERR_DEVICE_NOTREADY - Device is not ready to operate.';
    1800: stEcatIO.sErrorMessage := 'ADSERR_DEVICE_BUSY - Device is busy.';
    1801: stEcatIO.sErrorMessage := 'ADSERR_DEVICE_INVALIDCONTEXT - Invalid operating system context.';
    1802: stEcatIO.sErrorMessage := 'ADSERR_DEVICE_NOMEMORY - Insufficient memory.';
    1803: stEcatIO.sErrorMessage := 'ADSERR_DEVICE_INVALIDPARM - Invalid parameter values.';
    1804: stEcatIO.sErrorMessage := 'ADSERR_DEVICE_NOTFOUND - Not found (files, ...).';
    1805: stEcatIO.sErrorMessage := 'ADSERR_DEVICE_SYNTAX - Syntax error in file or command.';
    1806: stEcatIO.sErrorMessage := 'ADSERR_DEVICE_INCOMPATIBLE - Objects do not match.';
    1807: stEcatIO.sErrorMessage := 'ADSERR_DEVICE_EXISTS - Object already exists.';
    1808: stEcatIO.sErrorMessage := 'ADSERR_DEVICE_SYMBOLNOTFOUND - Symbol not found.';
    1809: stEcatIO.sErrorMessage := 'ADSERR_DEVICE_SYMBOLVERSIONINVALID - Invalid symbol version. This can occur due to an online change. Create a new handle.';
    1810: stEcatIO.sErrorMessage := 'ADSERR_DEVICE_INVALIDSTATE - Device (server) is in invalid state.';
    1811: stEcatIO.sErrorMessage := 'ADSERR_DEVICE_TRANSMODENOTSUPP - AdsTransMode not supported.';
    1812: stEcatIO.sErrorMessage := 'ADSERR_DEVICE_NOTIFYHNDINVALID - Notification handle is invalid.';
    1813: stEcatIO.sErrorMessage := 'ADSERR_DEVICE_CLIENTUNKNOWN - Notification client not registered.';
    1814: stEcatIO.sErrorMessage := 'ADSERR_DEVICE_NOMOREHDLS - No further handle available.';
    1815: stEcatIO.sErrorMessage := 'ADSERR_DEVICE_INVALIDWATCHSIZE - Notification size too large.';
    1816: stEcatIO.sErrorMessage := 'ADSERR_DEVICE_NOTINIT - Device not initialized.';
    1817: stEcatIO.sErrorMessage := 'ADSERR_DEVICE_TIMEOUT - Device has a timeout.';
    1818: stEcatIO.sErrorMessage := 'ADSERR_DEVICE_NOINTERFACE - Interface query failed.';
    1819: stEcatIO.sErrorMessage := 'ADSERR_DEVICE_INVALIDINTERFACE - Wrong interface requested.';
    1820: stEcatIO.sErrorMessage := 'ADSERR_DEVICE_INVALIDCLSID - Class ID is invalid.';
    1821: stEcatIO.sErrorMessage := 'ADSERR_DEVICE_INVALIDOBJID - Object ID is invalid.';
    1822: stEcatIO.sErrorMessage := 'ADSERR_DEVICE_PENDING - Request pending.';
    1823: stEcatIO.sErrorMessage := 'ADSERR_DEVICE_ABORTED - Request is aborted.';
    1824: stEcatIO.sErrorMessage := 'ADSERR_DEVICE_WARNING - Signal warning.';
    1825: stEcatIO.sErrorMessage := 'ADSERR_DEVICE_INVALIDARRAYIDX - Invalid array index.';
    1826: stEcatIO.sErrorMessage := 'ADSERR_DEVICE_SYMBOLNOTACTIVE - Symbol not active.';
    1827: stEcatIO.sErrorMessage := 'ADSERR_DEVICE_ACCESSDENIED - Access denied.';
    1828: stEcatIO.sErrorMessage := 'ADSERR_DEVICE_LICENSENOTFOUND - Missing license.';
    1829: stEcatIO.sErrorMessage := 'ADSERR_DEVICE_LICENSEEXPIRED - License expired.';
    1830: stEcatIO.sErrorMessage := 'ADSERR_DEVICE_LICENSEEXCEEDED - License exceeded.';
    1831: stEcatIO.sErrorMessage := 'ADSERR_DEVICE_LICENSEINVALID - Invalid license.';
    1832: stEcatIO.sErrorMessage := 'ADSERR_DEVICE_LICENSESYSTEMID - License problem: System ID is invalid.';
    1833: stEcatIO.sErrorMessage := 'ADSERR_DEVICE_LICENSENOTIMELIMIT - License not limited in time.';
    1834: stEcatIO.sErrorMessage := 'ADSERR_DEVICE_LICENSEFUTUREISSUE - Licensing problem: time in the future.';
    1835: stEcatIO.sErrorMessage := 'ADSERR_DEVICE_LICENSETIMETOLONG - License period too long.';
    1836: stEcatIO.sErrorMessage := 'ADSERR_DEVICE_EXCEPTION - Exception at system startup.';
    1837: stEcatIO.sErrorMessage := 'ADSERR_DEVICE_LICENSEDUPLICATED - License file read twice.';
    1838: stEcatIO.sErrorMessage := 'ADSERR_DEVICE_SIGNATUREINVALID - Invalid signature.';
    1839: stEcatIO.sErrorMessage := 'ADSERR_DEVICE_CERTIFICATEINVALID - Invalid certificate.';
    1840: stEcatIO.sErrorMessage := 'ADSERR_DEVICE_LICENSEOEMNOTFOUND - Public key not known from OEM.';
    1841: stEcatIO.sErrorMessage := 'ADSERR_DEVICE_LICENSERESTRICTED - License not valid for this system ID.';
    1842: stEcatIO.sErrorMessage := 'ADSERR_DEVICE_LICENSEDEMODENIED - Demo license prohibited.';
    1843: stEcatIO.sErrorMessage := 'ADSERR_DEVICE_INVALIDFNCID - Invalid function ID.';
    1844: stEcatIO.sErrorMessage := 'ADSERR_DEVICE_OUTOFRANGE - Outside the valid range.';
    1845: stEcatIO.sErrorMessage := 'ADSERR_DEVICE_INVALIDALIGNMENT - Invalid alignment.';
    1846: stEcatIO.sErrorMessage := 'ADSERR_DEVICE_LICENSEPLATFORM - Invalid platform level.';
    1847: stEcatIO.sErrorMessage := 'ADSERR_DEVICE_FORWARD_PL - Context - forward to passive level.';
    1848: stEcatIO.sErrorMessage := 'ADSERR_DEVICE_FORWARD_DL - Context - forward to dispatch level.';
    1849: stEcatIO.sErrorMessage := 'ADSERR_DEVICE_FORWARD_RT - Context - forward to real-time.';

    ELSE
    stEcatIO.sErrorMessage := 'Unknown ADS error code.';
END_CASE

IF fbgetStatusTimer.Q THEN
     fbgetStatusTimer.IN := FALSE; // reset timer
ELSE
    fbgetStatusTimer.IN := TRUE; // reset timer
END_IF]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>