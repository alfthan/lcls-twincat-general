<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_TempSensor" Id="{d7de6be9-251a-4df0-a4bb-4330b01e3329}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_TempSensor
(*
    Handles scaling and default diagnostics for temperature sensors,
    such as thermocouples, RTDs, and others.

    Usage:
        Instantiate, link iRaw/bError/bOverrange to the terminal process data
        and read fTemp/bConnected. Set bInputsNormallyClosed := FALSE when the
        terminal reports its status bits active-high (the Beckhoff EL32xx
        process data default).

    2020-03-02 Zachary Lentz
    2026-11-27 taio: the raw fault/status inputs are now interpreted as
        normally closed / fail-safe through F_TempSensor_Connected, so a
        de-energized input (broken wiring, unpowered terminal) reports the
        sensor as not connected instead of healthy (audit finding 0efeb122).
*)
VAR_INPUT
    // Resolution parameter from the Beckhoff docs. Default is 0.1 for 0.1 degree resolution
    fResolution: LREAL := 0.1;

    // Input polarity of the raw fault/status inputs: TRUE (default) treats them as fail-safe normally closed
    // contacts, where a de-energized input (FALSE) is a fault. Set FALSE for terminals that report their status
    // bits active-high, e.g. the Beckhoff EL32xx process data default.
    bInputsNormallyClosed: BOOL := TRUE;
END_VAR
VAR_OUTPUT
    {attribute 'pytmc' := '
        pv: TEMP
        io: input
        field: EGU C
        field: PREC 2
    '}
    fTemp: LREAL;

    {attribute 'pytmc' := '
        pv: CONN
        io: input
        field: ONAM Connected
        field: ZNAM Disconnected
    '}
    bConnected: BOOL;

    {attribute 'pytmc' := '
        pv: ERR
        io: input
        field: ONAM True
        field: ZNAM False
    '}
    bError AT %I*: BOOL := TRUE;

    bUnderrange AT %I*: BOOL;
    bOverrange AT %I*: BOOL;
END_VAR
VAR
    iRaw AT %I*: INT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// The raw fault/status inputs are evaluated as normally closed / fail-safe contacts, so a
// de-energized input (broken wiring, missing terminal, unpowered hardware) forces bConnected
// FALSE instead of reporting a healthy sensor that has in fact lost its signal.
bConnected := F_TempSensor_Connected(
    i_bError := bError,
    i_bOverrange := bOverrange,
    i_bInputsNormallyClosed := bInputsNormallyClosed);

fTemp := INT_TO_LREAL(iRaw) * fResolution;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>