<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_EL6_Com" Id="{b4ce63ed-a08f-4c98-b824-d65c9e8a72f4}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_EL6_Com
(*
    Communicate with a serial device connected to an EL6XXX
    2019-10-09 Zachary Lentz and Jackson Sheppard

    May contain assumptions about the device we wrote it for, potentially will need to be adjusted

    Usage:
        Call this block once per PLC cycle. Set sCmd to the command text and pulse bSend TRUE
        for one cycle to send it. sResponse holds the device reply and bDone goes TRUE once the
        reply has been received and accepted. stIn_EL6/stOut_EL6 must be wired to the EL6XXX
        terminal's process-data images - see the comments on those declarations.

    Objectives:
        Wrap the EL6XXX serial line (SerialLineControl, SERIALLINEMODE_EL6_22B) in a one-command
        at a time, non-blocking state machine: clear buffers, send sSendPrefix + sCmd + sSendSuffix,
        then wait for a reply that is not an echo of what we sent.

    History:
        2019-10-09 Zachary Lentz and Jackson Sheppard: initial version
        2026-11-27 Documented every declaration and removed the unused fbFormatString,
                   sLastReceivedString and bReceiveError members
*)
VAR_INPUT
    // Command text to send to the serial device, without the sSendPrefix/sSendSuffix wrappers
    {attribute 'pytmc' := '
        pv: CMD
        io: io
    '}
    sCmd: STRING;

    // Pulse TRUE for one cycle when it's time to send sCmd; the block clears it again itself
    {attribute 'pytmc' := '
        pv: SEND
        io: io
    '}
    bSend: BOOL;

    // Static text inserted before every sent message, e.g. an address/header (usually empty)
    sSendPrefix: STRING;
    // Static text appended after every sent message, e.g. a CR/LF terminator (usually empty)
    sSendSuffix: STRING;
    // Static text stripped from the start of every received message (usually empty)
    sRecvPrefix: STRING;
    // Static text stripped from the end of every received message, e.g. a CR/LF terminator
    sRecvSuffix: STRING;
    // Receive timeout [TIME, default T#1S]: how long fbReceive waits for the device reply before
    // it gives up; the expiry is reported on bReceiveTimeout
    tTimeout: TIME := T#1S;
END_VAR
VAR_IN_OUT
    // EL6XXX process-data INPUT image (EL6inData22B): the bytes the terminal has received from
    // the serial device, read by the PLC. Wire this reference to the terminal's "Inputs" image;
    // ADR(stIn_EL6) is passed to SerialLineControl as pComIn. Swapping it with stOut_EL6 breaks
    // communication silently.
    stIn_EL6: EL6inData22B;
    // EL6XXX process-data OUTPUT image (EL6outData22B): the bytes the PLC wants the terminal to
    // transmit on its serial line. Wire this reference to the terminal's "Outputs" image;
    // ADR(stOut_EL6) is passed to SerialLineControl as pComOut. This is NOT the reply buffer -
    // replies arrive in stIn_EL6 and are handed back through sResponse.
    stOut_EL6: EL6outData22B;
END_VAR
VAR_OUTPUT
    // The response received from the serial device, with sRecvPrefix/sRecvSuffix stripped off
    {attribute 'pytmc' := '
        pv: RESP
        io: input
    '}
    sResponse: STRING;

    // TRUE once a response has been received and written to sResponse; cleared when bSend is pulsed
    {attribute 'pytmc' := '
        pv: DONE
        io: input
    '}
    bDone: BOOL;

    // Error code (ComError_t enum) reported by the SerialLineControl instance that drives the
    // EL6XXX terminal; COMERROR_NOERROR when the serial line is healthy
    {attribute 'pytmc' := '
        pv: ERR:SER
        io: input
    '}
    eSerialLineErrorID: ComError_t;

    // Error code (ComError_t enum) of the send attempt in progress; COMERROR_NOERROR on success
    {attribute 'pytmc' := '
        pv: ERR:SEND
        io: input
    '}
    eSendErrorID: ComError_t;

    // Error code (ComError_t enum) of the reply attempt in progress; COMERROR_NOERROR on success
    // or while still waiting for a reply
    {attribute 'pytmc' := '
        pv: ERR:RECV
        io: input
    '}
    eRecvErrorID: ComError_t;
END_VAR
VAR
    // Communication buffers
    // Bytes queued by fbSend for transmission to the EL6XXX terminal (drained by fbEL6Ctrl)
    TxBuffer: ComBuffer;
    // Bytes received from the EL6XXX terminal (filled by fbEL6Ctrl, consumed by fbReceive)
    RxBuffer: ComBuffer;
    // Helper instance that empties a ComBuffer; called on both buffers before each new send
    fbClearComBuffer: ClearComBuffer;

    // Parameters for PLC -> EL6
    // Drives the EL6XXX terminal's 22 byte serial process data (Mode SERIALLINEMODE_EL6_22B)
    fbEL6Ctrl: SerialLineControl;
    // Latched TRUE once fbEL6Ctrl reported an error (serial line / terminal problem)
    bEL6CtrlError: BOOL;
    // Error code (ComError_t enum) captured from fbEL6Ctrl.ErrorID when bEL6CtrlError latched
    eEL6CtrlErrorID: ComError_t;

    // Parameters for EL6 -> Serial Device
    // Sends one message: fills TxBuffer with the string, for the EL6XXX terminal to transmit
    fbSend: SendString;
    // TRUE while fbSend is still transmitting the current message
    bSendBusy: BOOL;
    // Last non-zero ComError_t reported by fbSend; COMERROR_NOERROR until the first failure
    eLastSendErrorID: ComError_t;
    // Waits for and collects one reply from the serial device, honouring sRecvPrefix/sRecvSuffix
    // and tTimeout
    fbReceive: ReceiveString;
    // Destination string fbReceive writes the assembled reply into; valid when bStringReceived
    sReceivedString: STRING;
    // TRUE on the cycle fbReceive completed a message
    bStringReceived: BOOL;
    // TRUE while fbReceive is still waiting for / assembling a message
    bReceiveBusy: BOOL;
    // ComError_t of the reply attempt, captured for diagnostics (not currently consumed)
    eReceiveErrorID: ComError_t;
    // TRUE when the last reply attempt ended in a timeout, i.e. nothing arrived within tTimeout
    // [TIME]; mirrors fbReceive.RxTimeout
    bReceiveTimeout: BOOL;
    // Count of replies received successfully, incremented once per completed reply [count]
    nReceiveCounter: UDINT;
    // Count of send attempts that reported no error [count]
    nSendCounter: UDINT;
    // The exact message handed to fbSend: sSendPrefix + sCmd + sSendSuffix
    sStringToSend: STRING;

    // Parameters for state-machine implementation
    // Current step of the command sequencer: 0 = idle, 10 = clear buffers/prepare/send,
    // 20 = wait for the send to finish, 30 = wait for the reply
    nStep: INT := 0;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[fbEL6Ctrl(
    Mode:= SERIALLINEMODE_EL6_22B,
    pComIn:= ADR(stIn_EL6),
    pComOut:= ADR(stOut_EL6),
    SizeComIn:= UINT_TO_INT(SIZEOF(stIn_EL6)),
    Error=> ,
    ErrorID=> eSerialLineErrorID,
    TxBuffer:= TxBuffer,
    RxBuffer:= RxBuffer );
IF fbEL6Ctrl.Error THEN
    bEL6CtrlError := TRUE;
    eEL6CtrlErrorID := fbEL6Ctrl.ErrorID;
END_IF
IF bSend THEN
    nStep := 10;
    bSend := FALSE;
    bDone := FALSE;
END_IF
// Attempt at solution that sends one command at a time, not on constant loop
CASE nStep OF
    0:
        ; // idle
    10:
        // Clear buffers in case any lingering data
        fbClearComBuffer(Buffer:=TxBuffer);
        fbClearComBuffer(Buffer:=RxBuffer);
        // Prepare string to send
        sStringToSend := CONCAT(sSendPrefix, CONCAT(sCmd, sSendSuffix));
        // Send string
        fbSend(	SendString:= sStringToSend,
                TXbuffer:= TxBuffer,
                Busy=> bSendBusy,
                Error=> eSendErrorID);
        IF fbSend.Error <> COMERROR_NOERROR THEN
            eLastSendErrorID := fbSend.Error;
        ELSE
            nSendCounter := nSendCounter + 1;
        END_IF
        nStep := nStep + 10;
    20:
        // Finish sending String
        IF fbSend.Busy THEN
            fbSend(	SendString:= sStringToSend,
                    TXbuffer:= TxBuffer,
                    Busy=> bSendBusy,
                    Error=> eSendErrorID);
            IF fbSend.Error <> COMERROR_NOERROR THEN
                eLastSendErrorID := fbSend.Error;
            ELSE
                nSendCounter := nSendCounter + 1;
            END_IF
        ELSE
            nStep := nStep + 10;
        END_IF
    30:
        // Get Reply
        fbReceive(
            Prefix:= sRecvPrefix,
            Suffix:= sRecvSuffix,
            Timeout:= tTimeout,
            ReceivedString:= sReceivedString,
            RXbuffer:= RxBuffer,
            StringReceived=> bStringReceived,
            Busy=> bReceiveBusy,
            Error=> eRecvErrorID,
            RxTimeout=> bReceiveTimeout );
        IF fbReceive.Error <> COMERROR_NOERROR THEN
            eReceiveErrorID := fbReceive.Error;
        END_IF
        IF bStringReceived THEN
            nReceiveCounter := nReceiveCounter + 1;
            // Check for response
            IF FIND(sReceivedString, sStringToSend)=0 THEN
                sResponse := sReceivedString;
                bDone := TRUE;
                nStep := 0;
            END_IF
        END_IF
END_CASE]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>