<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_UnixTimeStamp" Id="{74adc114-3015-429e-b699-b551ce54d443}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_UnixTimeStamp
(*
    Get the unix timestamp equivalent of the PLC's time.
    2019-10-09 Zachary Lentz

    This will only sync with the Linux host when both hosts' clocks are correct.
    Largely stolen from stack overflow

    History:
    2026-11-27 The FILETIME tick resolution, the 1601-to-1970 epoch offset and the high-word
               shift are no longer literals here: they are the named constants
               GeneralConstants.FILETIME_TICKS_PER_MS, UNIX_EPOCH_OFFSET_MS,
               FILETIME_HIGH_WORD_SHIFT and MS_PER_S, so they are declared once and shared
               with the other time conversion helpers.
*)
VAR_INPUT
    // If TRUE, we'll try to update the output on this cycle.
    bExecute: BOOL;
END_VAR
VAR_OUTPUT
    // Number of seconds in the timestamp
    iSeconds: ULINT;
    // Number of milliseconds past the seconds
    iMilliseconds: ULINT;
    // Full raw number
    iFull: ULINT;
    // Full floating point number in units of seconds
    fTime: LREAL;
    // TRUE if the output is okay to use on this cycle. Typically the output is zero when this is FALSE.
    bValid: BOOL;
END_VAR
VAR
    bInit: BOOL;
    fbLocalTime: FB_LocalSystemTime;
    fbGetTimeZone: FB_GetTimeZoneInformation;
    fbTimeConv: FB_TzSpecificLocalTimeToFileTime;
    stfileTime: T_FILETIME;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF NOT bInit THEN
    bInit := TRUE;
    fbGetTimeZone(bExecute:=TRUE, tzInfo => fbTimeConv.tzInfo);
END_IF
IF bExecute THEN
    fbLocalTime(
        bEnable := TRUE,
        dwCycle := 1,
        bValid => bValid);
    IF bValid THEN
        fbTimeConv(
            in := SYSTEMTIME_TO_FILETIME(fbLocalTime.systemTime),
            out => stfileTime);
        // Join the two 32-bit halves of the FILETIME value into one 64-bit tick count, convert
        // 100 ns ticks to milliseconds, then move the epoch from 1601 (FILETIME) to 1970 (Unix).
        // The tick resolution, epoch offset and half-word shift are declared once in
        // GeneralConstants so they can be reviewed and corrected in one place.
        iFull := (SHL(DWORD_TO_ULINT(stfileTime.dwHighDateTime), GeneralConstants.FILETIME_HIGH_WORD_SHIFT)
                  + DWORD_TO_ULINT(stfileTime.dwLowDateTime)) / GeneralConstants.FILETIME_TICKS_PER_MS
                  - GeneralConstants.UNIX_EPOCH_OFFSET_MS;
        // Split the millisecond timestamp into whole seconds plus a remainder.
        fTime := ULINT_TO_LREAL(iFull) / ULINT_TO_LREAL(GeneralConstants.MS_PER_S);
        iSeconds := iFull / GeneralConstants.MS_PER_S;
        iMilliseconds := iFull MOD GeneralConstants.MS_PER_S;
    END_IF
END_IF]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>