<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_TimeStampBufferGlobal" Id="{555c8b1d-2427-4d2c-8222-da9abd69b89f}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_TimeStampBufferGlobal
(*
    A Variant of FB_TimeStampBuffer that uses the global timestamp.
    2019-10-09 Zachary Lentz

    Assumes an instance of FB_UnixTimeStampGlobal is running every cycle.
*)
VAR_INPUT
    // If TRUE, we'll accumulate a value on this cycle.
    bExecute: BOOL;
END_VAR
VAR_OUTPUT
    // Rolling buffer holding the last 1000 accumulated timestamps, in units of
    // seconds since the Unix epoch (resolution 1 ms), copied from
    // DefaultGlobals.fTimeStamp.
    // Ordering: oldest sample first; arrOutput[1] is the oldest value of the
    // completed buffer and arrOutput[1000] is the most recently accumulated one.
    // Semantics: only refreshed when the internal partial buffer fills, so the
    // contents stay stale (previous batch) until bNewArray pulses TRUE.
    arrOutput: ARRAY [1..1000] OF LREAL;
    // TRUE for exactly one cycle, on the cycle where arrOutput is refreshed (the
    // internal 1000-element partial buffer just became full). FALSE all other
    // cycles. Use as the handshake to copy or consume arrOutput.
    bNewArray: BOOL;
END_VAR
VAR
    // Internal helper that accumulates one timestamp per cycle and hands over the
    // completed 1000-element buffer.
    fbLREALBuffer: FB_LREALBuffer;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[fbLREALBuffer(
    bExecute := bExecute,
    fInput := DefaultGlobals.fTimeStamp,
    arrOutput => arrOutput,
    bNewArray => bNewArray);]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>