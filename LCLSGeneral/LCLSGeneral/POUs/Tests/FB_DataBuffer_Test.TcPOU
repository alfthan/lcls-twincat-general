      </Implementation>
    </Method>
    <Method Name="TestResetClearsErrorAfterFix" Id="{4217D8D7-48B4-4C2C-B2BB-2174C1B6F578}">
      <Declaration><![CDATA[METHOD TestResetClearsErrorAfterFix
VAR
    // Block under test
    fbDataBuffer: FB_DataBuffer;
    // Rolling buffer
    arrPartial: ARRAY [1..4] OF INT;
    // Output buffer
    arrOutput: ARRAY [1..4] OF INT;
    // Deliberately unbound output buffer address
    pNullAdr: PVOID;
    // Value to accumulate
    nInput: INT;
    // Current element
    nIndex: INT;
    // Whether the output buffer was copied on the last cycle
    bNewArray: BOOL;
    // Whether the supplied parameters were rejected
    bError: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('TestResetClearsErrorAfterFix');

// Reject first: the output buffer address is unbound
fbDataBuffer(
    bExecute := TRUE,
    pInputAdr := ADR(nInput),
    iInputSize := SIZEOF(nInput),
    iElemCount := 4,
    pPartialAdr := ADR(arrPartial),
    pOutputAdr := pNullAdr,
    bNewArray => bNewArray,
    bError => bError);

AssertEquals_BOOL(Expected := TRUE,
    Actual := bError,
    Message := 'A zero output buffer address must be rejected');

// Dropping bExecute must not dismiss the latched error
fbDataBuffer(
    bExecute := FALSE,
    pInputAdr := ADR(nInput),
    iInputSize := SIZEOF(nInput),
    iElemCount := 4,
    pPartialAdr := ADR(arrPartial),
    pOutputAdr := pNullAdr,
    bNewArray => bNewArray,
    bError => bError);

AssertEquals_BOOL(Expected := TRUE,
    Actual := bError,
    Message := 'The latched error must stay set while the inputs are still invalid');

// bReset with corrected inputs clears it
fbDataBuffer(
    bExecute := FALSE,
    bReset := TRUE,
    pInputAdr := ADR(nInput),
    iInputSize := SIZEOF(nInput),
    iElemCount := 4,
    pPartialAdr := ADR(arrPartial),
    pOutputAdr := ADR(arrOutput),
    bNewArray => bNewArray,
    bError => bError);

AssertEquals_BOOL(Expected := FALSE,
    Actual := bError,
    Message := 'bReset must clear the latched error once the inputs are valid');

// Accumulation resumes and fills the output buffer
FOR nIndex := 1 TO 4 DO
    nInput := nIndex;
    fbDataBuffer(
        bExecute := TRUE,
        pInputAdr := ADR(nInput),
        iInputSize := SIZEOF(nInput),
        iElemCount := 4,
        pPartialAdr := ADR(arrPartial),
        pOutputAdr := ADR(arrOutput),
        bNewArray => bNewArray,
        bError => bError);
END_FOR

AssertEquals_BOOL(Expected := TRUE,
    Actual := bNewArray,
    Message := 'Accumulation must resume after the error has been cleared');

AssertEquals_INT(Expected := 4,
    Actual := arrOutput[4],
    Message := 'The output buffer must hold the accumulated values after recovery');

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
