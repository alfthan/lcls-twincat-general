<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <GVL Name="GeneralConstants" Id="{5fbde5e2-29c8-4193-ba17-69759df29f93}" ParameterList="True">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'analysis' := '-33'}
VAR_GLOBAL CONSTANT
    // 16 including "Unknown" is the max for an EPICS MBBI/MBBO
    // This is the max number of user-defined states (OUT, TARGET1, YAG...)
    // You can make this smaller if you want to use less memory in your program in exchange for limiting your max state count
    // You can make this larger if you want to use states-based FBs sized beyond the EPICS enum limit
    MAX_STATES: UINT := 15;

    // Tolerance used when deciding whether an EPICS motor is still moving.
    // The motor record's DMOV field arrives over an EPICS link as an LREAL, so
    // the test is ABS(DMOV) < cMovingEpsilon: any value below the tolerance
    // (including small non-zero residues) means "still moving".
    // Declared here so the threshold is visible and tunable in one place
    // instead of being buried in FB_EpicsMotorMonitor.
    cMovingEpsilon: LREAL := 1.0E-5;
END_VAR
]]></Declaration>
  </GVL>
</TcPlcObject>